# Three frontier models, each reviewing alone, on the same two test set pull requests:
# JavaScript (6, a 20 KB diff) and Java (12, a 40 KB diff).
# Claude Opus 5.5 verifies in every run, so the runs differ only in the reviewer.
solo-opus  6,12 RB_CONFIG_MODEL=anthropic/claude-opus-5.5 RB_CONFIG_VERIFIER=anthropic/claude-opus-5.5
solo-kimi  6,12 RB_CONFIG_MODEL=moonshotai/kimi-k3 RB_CONFIG_VERIFIER=anthropic/claude-opus-5.5
solo-astra 6,12 RB_CONFIG_MODEL=openai/gpt-6-astra RB_CONFIG_VERIFIER=anthropic/claude-opus-5.5
