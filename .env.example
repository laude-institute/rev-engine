# The model API the reviewer calls: any OpenAI-compatible endpoint. Copy this file to .env.
# OpenRouter is the example here. Use a dedicated key with a spend cap.
RB_MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
# Optional: a JSON object merged into every request body. For OpenRouter, usage.include reports
# what each call cost. The second asks OpenRouter to cache prompts for Anthropic models alone.
RB_MODEL_EXTRA_BODY='{"usage":{"include":true}}'
RB_MODEL_EXTRA_BODY_BY_MODEL='{"anthropic/":{"cache_control":{"type":"ephemeral"}}}'
